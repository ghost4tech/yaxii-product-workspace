{
  "name": "yaxii/product-workspace",
  "description": "A focused WooCommerce product-entry workspace for WordPress administrators.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/woocommerce-stubs": "^10.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.2",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Yaxii\\ProductWorkspace\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yaxii\\ProductWorkspace\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "autoloader-suffix": "YaxiiProductWorkspace100",
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.29"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "@php tools/lint-php.php",
    "phpcs": "@php vendor/bin/phpcs",
    "phpstan": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
    "test": "@php vendor/bin/phpunit -c phpunit.unit.xml.dist",
    "test:integration": "@php vendor/bin/phpunit -c phpunit.integration.xml.dist",
    "check": [
      "@composer validate --strict",
      "@lint",
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  }
}
