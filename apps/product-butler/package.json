{
  "name": "@yaxii/product-workspace-frontend",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src/main.tsx src/production tools vite.config.ts vitest.config.ts",
    "check:lines": "node tools/check-production-lines.mjs",
    "check:boundary": "node tools/check-production-boundary.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:production": "npm audit --omit=dev",
    "check": "npm run typecheck && npm run lint && npm run check:lines && npm test && npm run build && npm run check:boundary"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.4.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.50.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
