#. Plugin Name of the plugin
#: yaxii-product-workspace.php
#: src/Admin/AdminPage.php:48
#: src/Admin/AdminPage.php:153
msgid "Yaxii Product Workspace"
msgstr "Yaxii Product Workspace"

#. Author URI of the plugin
#: yaxii-product-workspace.php
msgid "https://yaxii.dev/"
msgstr "https://yaxii.dev/"

#. Description of the plugin
#: yaxii-product-workspace.php
msgid "A focused WooCommerce product-entry workspace for WordPress administrators."
msgstr "Un espace de travail WooCommerce dédié à la saisie de produits pour les administrateurs WordPress."

#. Author of the plugin
#: yaxii-product-workspace.php
msgid "Yaxii Dev"
msgstr "Yaxii Dev"

#: src/Admin/AdminPage.php:49
msgid "Product Workspace"
msgstr "Espace de travail des produits"

#: src/Admin/AdminPage.php:149
msgid "You are not allowed to access this workspace."
msgstr "Vous n’êtes pas autorisé à accéder à cet espace de travail."

#: src/Admin/AdminPage.php:186
msgid "The Product Workspace frontend is unavailable because its built assets are missing."
msgstr "L’interface de Product Workspace est indisponible, car ses ressources compilées sont manquantes."

#: src/Admin/AdminPage.php:190
msgid "WooCommerce must be installed and active before the Product Workspace can be used."
msgstr "WooCommerce doit être installé et activé pour utiliser Product Workspace."

#: src/Admin/AdminPage.php:193
msgid "Loading Yaxii Product Workspace..."
msgstr "Chargement de Yaxii Product Workspace…"

#: src/Application/Preferences/PreferenceService.php:60
msgid "The preference request contains unsupported fields."
msgstr "La demande de préférence contient des champs non pris en charge."

#: src/Application/Preferences/PreferenceService.php:65
msgid "Review the workspace preferences."
msgstr "Vérifiez les préférences de l’espace de travail."

#: src/Application/Preferences/PreferenceService.php:102
#: src/Application/Products/CreateProductRequestFactory.php:181
#: src/Application/VariableProducts/VariationInputParser.php:130
msgid "Expected true or false."
msgstr "Une valeur vraie ou fausse est attendue."

#: src/Application/Preferences/PreferenceService.php:113
msgid "Choose only supported repeat fields."
msgstr "Choisissez uniquement les champs de répétition pris en charge."

#: src/Application/Preferences/PreferenceService.php:116
msgid "Choose 10, 25, or 50 queue rows."
msgstr "Choisissez 10, 25 ou 50 lignes de file d’attente."

#: src/Application/Preferences/PreferenceService.php:124
#: src/Application/Products/ProductFieldParser.php:28
msgid "Choose a supported value."
msgstr "Choisissez une valeur prise en charge."

#: src/Application/Products/CreateProductRequestFactory.php:77
msgid "Every product field must be present; send an empty value to clear a field."
msgstr "Tous les champs du produit doivent être présents ; envoyez une valeur vide pour effacer un champ."

#: src/Application/Products/CreateProductRequestFactory.php:79
msgid "Reload the product before saving this update."
msgstr "Rechargez le produit avant d’enregistrer cette mise à jour."

#: src/Application/Products/CreateProductRequestFactory.php:129
msgid "Product name is required."
msgstr "Le nom du produit est obligatoire."

#: src/Application/Products/CreateProductRequestFactory.php:131
msgid "Product name must be 200 characters or fewer."
msgstr "Le nom du produit doit comporter 200 caractères maximum."

#: src/Application/Products/CreateProductRequestFactory.php:134
msgid "SKU must be 100 characters or fewer."
msgstr "Le SKU doit comporter 100 caractères maximum."

#: src/Application/Products/CreateProductRequestFactory.php:151
#: src/Application/VariableProducts/VariationInputParser.php:60
msgid "Sale price cannot exceed the regular price."
msgstr "Le prix promo ne peut pas dépasser le prix normal."

#: src/Application/Products/CreateProductRequestFactory.php:156
msgid "Sale end date cannot be before the start date."
msgstr "La date de fin de vente ne peut pas être antérieure à la date de début."

#: src/Application/Products/CreateProductRequestFactory.php:165
msgid "The request contains unsupported fields."
msgstr "La demande contient des champs non pris en charge."

#: src/Application/Products/CreateProductRequestFactory.php:176
#: src/Application/VariableProducts/VariationInputParser.php:138
msgid "Expected a text value."
msgstr "Une valeur textuelle est attendue."

#: src/Application/Products/CreateProductRequestFactory.php:193
msgid "Review the highlighted product fields."
msgstr "Passez en revue les champs de produits en surbrillance."

#: src/Application/Products/CreateProductService.php:58
msgid "The product request could not be normalized."
msgstr "La demande de produit n’a pas pu être normalisée."

#: src/Application/Products/CreateProductService.php:81
msgid "This idempotency key was already used with a different product payload."
msgstr "Cette clé d’idempotence était déjà utilisée avec une autre charge utile de produit."

