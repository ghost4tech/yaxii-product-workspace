#. Plugin Name of the plugin
#: yaxii-product-workspace.php
#: src/Admin/AdminPage.php:46
#: src/Admin/AdminPage.php:152
msgid "Yaxii Product Workspace"
msgstr "Yaxii Product Workspace"

#. Author URI of the plugin
#: yaxii-product-workspace.php
msgid "https://yaxii.dev/"
msgstr "https://yaxii.dev/"

#. Description of the plugin
#: yaxii-product-workspace.php
msgid "A focused WooCommerce product-entry workspace for WordPress administrators."
msgstr "Un espace de travail WooCommerce dédié à la saisie de produits pour les administrateurs WordPress."

#. Author of the plugin
#: yaxii-product-workspace.php
msgid "Yaxii Dev"
msgstr "Yaxii Dev"

#: src/Admin/AdminPage.php:47
msgid "Product Workspace"
msgstr "Espace de travail des produits"

#: src/Admin/AdminPage.php:148
msgid "You are not allowed to access this workspace."
msgstr "Vous n’êtes pas autorisé à accéder à cet espace de travail."

#: src/Admin/AdminPage.php:184
msgid "The Product Workspace frontend is unavailable because its built assets are missing."
msgstr "L’interface de Product Workspace est indisponible, car ses ressources compilées sont manquantes."

#: src/Admin/AdminPage.php:188
msgid "WooCommerce must be installed and active before the Product Workspace can be used."
msgstr "WooCommerce doit être installé et activé pour utiliser Product Workspace."

#: src/Admin/AdminPage.php:191
msgid "Loading Yaxii Product Workspace..."
msgstr "Chargement de Yaxii Product Workspace…"

#: src/Application/Preferences/PreferenceService.php:60
msgid "The preference request contains unsupported fields."
