msgid "This operation is not marked safe for manual retry."
msgstr "Cette opération n’est pas marquée comme étant sûre pour une nouvelle tentative manuelle."

#: src/Application/Products/CreateProductService.php:126
msgid "This operation is already being reconciled or retried."
msgstr "Cette opération est déjà en cours de réconciliation ou de nouvelle tentative."

#: src/Application/Products/CreateProductService.php:135
msgid "WooCommerce is not available for product creation."
msgstr "WooCommerce n’est pas disponible pour la création de produits."

#: src/Application/Products/CreateProductService.php:143
msgid "You are not allowed to create products."
msgstr "Vous n’êtes pas autorisé à créer des produits."

#: src/Application/Products/CreateProductService.php:151
#: src/Application/VariableProducts/VariableProductService.php:154
msgid "You can create drafts but cannot publish products."
msgstr "Vous pouvez créer des brouillons mais ne pouvez pas publier de produits."

#: src/Application/Products/CreateProductService.php:153
msgid "Choose Draft or ask an administrator for publishing access."
msgstr "Choisissez Brouillon ou demandez à un administrateur l’accès à la publication."

#: src/Application/Products/CreateProductService.php:160
msgid "You are not allowed to assign product terms."
msgstr "Vous n’avez pas l’autorisation d’attribuer des termes de produit."

#: src/Application/Products/CreateProductService.php:171
msgid "You are not allowed to use one or more selected images."
msgstr "Vous n’êtes pas autorisé à utiliser une ou plusieurs images sélectionnées."

#: src/Application/Products/CreateProductService.php:209
msgid "WooCommerce could not save the product."
msgstr "WooCommerce n’a pas pu enregistrer le produit."

#: src/Application/Products/CreateProductService.php:226
msgid "WooCommerce rejected one or more product references."
msgstr "WooCommerce a rejeté une ou plusieurs références de produits."

#: src/Application/Products/OperationResult.php:54
msgid "Some variations were not saved. Retry reconciliation before publishing."
msgstr "Certaines variations n’ont pas été enregistrées. Relancez la vérification avant de publier."

#: src/Application/Products/ProductFieldParser.php:39
msgid "A non-negative decimal value is required."
msgstr "Une valeur décimale non négative est requise."

#: src/Application/Products/ProductFieldParser.php:44
#: src/Application/VariableProducts/VariationInputParser.php:80
msgid "Enter a valid non-negative decimal value."
msgstr "Entrez une valeur décimale non négative valide."

#: src/Application/Products/ProductFieldParser.php:58
msgid "Enter a valid calendar date."
msgstr "Entrez une date de calendrier valide."

#: src/Application/Products/ProductFieldParser.php:69
#: src/Application/VariableProducts/VariationInputParser.php:93
msgid "Stock quantity is required when stock management is enabled."
msgstr "La quantité en stock est requise lorsque la gestion des stocks est activée."

#: src/Application/Products/ProductFieldParser.php:74
#: src/Application/VariableProducts/VariationInputParser.php:90
msgid "Stock quantity must be a non-negative whole number."
msgstr "La quantité en stock doit être un nombre entier non négatif."

#: src/Application/Products/ProductFieldParser.php:87
msgid "Expected a positive numeric ID."
msgstr "Un identifiant numérique positif est attendu."

#: src/Application/Products/ProductFieldParser.php:98
msgid "Expected a list of numeric IDs."
msgstr "Une liste d’identifiants numériques est attendue."

#: src/Application/Products/ProductFieldParser.php:103
msgid "Every referenced ID must be a positive integer."
msgstr "Chaque identifiant référencé doit être un entier positif."

#: src/Application/Products/ProductFieldParser.php:106
msgid "Select at least one product category."
msgstr "Sélectionnez au moins une catégorie de produits."

#. translators: %d: maximum referenced items.
#: src/Application/Products/ProductFieldParser.php:109
#, php-format
msgid "No more than %d items are allowed."
msgstr "Vous ne pouvez pas sélectionner plus de %d éléments."

#: src/Application/Products/ProductManagementService.php:66
msgid "WooCommerce rejected one or more product fields."
msgstr "WooCommerce a rejeté un ou plusieurs champs de produits."

#: src/Application/Products/ProductManagementService.php:81
msgid "You are not allowed to trash this product."
msgstr "Vous n’avez pas l’autorisation de mettre ce produit à la corbeille."

#: src/Application/Products/ProductManagementService.php:89
msgid "WooCommerce products are unavailable."
msgstr "Les produits WooCommerce ne sont pas disponibles."

#: src/Application/Products/ProductManagementService.php:92
#: src/Rest/ApiError.php:29
msgid "You are not allowed to manage products."
msgstr "Vous n’êtes pas autorisé à gérer les produits."

#: src/Application/Products/ProductManagementService.php:117
msgid "You are not allowed to edit this product."
msgstr "Vous n’êtes pas autorisé à modifier ce produit."

#: src/Application/Products/ProductManagementService.php:123
#: src/Application/VariableProducts/VariableProductManagementService.php:68
msgid "You cannot publish products."
msgstr "Vous ne pouvez pas publier de produits."

#: src/Application/Products/ProductManagementService.php:126
msgid "You cannot assign product terms."
msgstr "Vous ne pouvez pas attribuer de termes de produit."

#: src/Application/Products/ProductManagementService.php:133
#: src/Application/VariableProducts/VariableProductManagementService.php:82
msgid "You cannot use one or more selected images."
msgstr "Vous ne pouvez pas utiliser une ou plusieurs images sélectionnées."

#: src/Application/Products/ProductManagementService.php:146
msgid "This product changed after it was opened. Reload it before saving."
msgstr "Ce produit a été modifié après son ouverture. Rechargez-le avant de l’enregistrer."

#: src/Application/VariableProducts/CombinationGenerator.php:44
msgid "Generate every projected variation combination before saving."
msgstr "Générez toutes les combinaisons de variations prévues avant d’enregistrer."

#: src/Application/VariableProducts/CombinationGenerator.php:55
#: src/Application/VariableProducts/VariationInputParser.php:32
msgid "Each combination requires a unique client UUID."
msgstr "Chaque combinaison nécessite un UUID client unique."

#: src/Application/VariableProducts/CombinationGenerator.php:58
msgid "Duplicate variation combinations are not allowed."
msgstr "Les combinaisons de variations en double ne sont pas autorisées."

#: src/Application/VariableProducts/CombinationGenerator.php:74
msgid "Each combination must be an object."
msgstr "Chaque combinaison doit être un objet."

#: src/Application/VariableProducts/CombinationGenerator.php:80
msgid "The combination references an unknown attribute option."
msgstr "La combinaison fait référence à une option d’attribut inconnue."

#: src/Application/VariableProducts/CombinationGenerator.php:143
#: languages/source/yaxii-product-workspace.js:415
msgid "Select one option from every variation attribute."
msgstr "Sélectionnez une option dans chaque attribut de variation."

#: src/Application/VariableProducts/CombinationGenerator.php:149
msgid "The combination contains an invalid or duplicate attribute reference."
msgstr "La combinaison contient une référence d’attribut non valide ou en double."

#: src/Application/VariableProducts/CombinationGenerator.php:154
msgid "The combination selection contains unsupported fields."
msgstr "La sélection de combinaison contient des champs non pris en charge."

#: src/Application/VariableProducts/CombinationGenerator.php:158
msgid "The combination contains an unknown attribute option."
msgstr "La combinaison contient une option d’attribut inconnue."

#: src/Application/VariableProducts/CombinationGenerator.php:183
#: src/Application/VariableProducts/VariationInputParser.php:157
msgid "Review the variable-product combinations."
msgstr "Vérifiez les combinaisons du produit variable."

#: src/Application/VariableProducts/VariableProductManagementService.php:30
msgid "You cannot edit this variable product."
msgstr "Vous ne pouvez pas modifier ce produit variable."

#: src/Application/VariableProducts/VariableProductManagementService.php:34
msgid "The requested variable product was not found."
msgstr "Le produit variable demandé n’a pas été trouvé."

#: src/Application/VariableProducts/VariableProductManagementService.php:44
msgid "This variable product changed after it was opened. Reload it before saving."
msgstr "Ce produit variable a été modifié après son ouverture. Rechargez-le avant de l’enregistrer."

#: src/Application/VariableProducts/VariableProductManagementService.php:49
msgid "WooCommerce rejected variable-product fields."
msgstr "WooCommerce a rejeté les champs de produits variables."

#: src/Application/VariableProducts/VariableProductManagementService.php:62
#: src/Application/VariableProducts/VariableProductService.php:148
msgid "WooCommerce variable products are unavailable."
msgstr "Les produits variables WooCommerce ne sont pas disponibles."

#: src/Application/VariableProducts/VariableProductManagementService.php:71
#: src/Application/VariableProducts/VariableProductService.php:157
msgid "You cannot assign product attributes or terms."
msgstr "Vous ne pouvez pas attribuer d’attributs ou de termes de produit."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:27
msgid "The variation plan contains unsupported fields."
msgstr "Le plan de variations contient des champs non pris en charge."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:30
msgid "Send attribute and combination lists."
msgstr "Envoyez des listes d’attributs et de combinaisons."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:36
msgid "At least one attribute must be used for variations."
msgstr "Au moins un attribut doit être utilisé pour les variantes."

#. translators: %d: maximum attributes.
#: src/Application/VariableProducts/VariableProductPlanFactory.php:63
#, php-format
msgid "Add between one and %d attributes."
msgstr "Ajoutez entre un et %d attributs."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:72
msgid "Each attribute must be an object."
msgstr "Chaque attribut doit être un objet."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:101
msgid "Each attribute requires a unique position."
msgstr "Chaque attribut nécessite une position unique."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:117
msgid "The attribute contains unsupported fields."
msgstr "L’attribut contient des champs non pris en charge."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:126
msgid "Use a stable lowercase attribute key."
msgstr "Utilisez une clé d’attribut stable en minuscules."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:150
msgid "Attribute visibility, variation use, or position is invalid."
msgstr "La visibilité, l’utilisation pour les variations ou la position de l’attribut n’est pas valide."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:175
msgid "Global attributes use term IDs, not custom option text."
msgstr "Les attributs globaux utilisent des identifiants de termes, et non du texte d’option personnalisé."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:181
msgid "Global attributes require a real WooCommerce attribute ID and pa_* taxonomy."
msgstr "Les attributs globaux nécessitent un véritable identifiant d’attribut WooCommerce et une taxonomie pa_*."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:196
msgid "Custom attributes cannot reference a global taxonomy or term IDs."
msgstr "Les attributs personnalisés ne peuvent pas référencer une taxonomie globale ni des identifiants de termes."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:200
msgid "Select between one and 20 custom options."
msgstr "Sélectionnez entre une et 20 options personnalisées."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:208
msgid "Custom options must be unique non-empty values up to 100 characters."
msgstr "Les options personnalisées doivent être des valeurs uniques non vides pouvant contenir jusqu’à 100 caractères."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:223
msgid "Select between one and 20 attribute terms."
msgstr "Sélectionnez entre un et 20 termes d’attribut."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:227
msgid "Attribute term IDs must be unique positive integers."
msgstr "Les identifiants de termes d’attribut doivent être des entiers positifs uniques."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:234
msgid "Review the variable-product attributes."
msgstr "Passez en revue les attributs du produit variable."

#: src/Application/VariableProducts/VariableProductRequestFactory.php:31
msgid "Send one product, attribute list, and combination list."
msgstr "Envoyez un produit, une liste d’attributs et une liste de combinaisons."

#: src/Application/VariableProducts/VariableProductService.php:43
msgid "The variable product could not be normalized."
msgstr "Le produit variable n’a pas pu être normalisé."

#: src/Application/VariableProducts/VariableProductService.php:60
msgid "This idempotency key was used with a different variable product."
msgstr "Cette clé d’idempotence a été utilisée avec un produit variable différent."

#: src/Application/VariableProducts/VariableProductService.php:79
msgid "This variable operation is not safe to retry."
msgstr "Cette opération variable ne peut pas être réessayée en toute sécurité."

#: src/Application/VariableProducts/VariableProductService.php:89
msgid "This variable operation is already being reconciled."
msgstr "Cette opération variable est déjà en cours de vérification."

#: src/Application/VariableProducts/VariableProductService.php:122
msgid "WooCommerce could not save the variable product."
msgstr "WooCommerce n’a pas pu enregistrer le produit variable."

#: src/Application/VariableProducts/VariableProductService.php:131
msgid "WooCommerce rejected variable-product references."
msgstr "WooCommerce a rejeté les références de produits variables."

#: src/Application/VariableProducts/VariableProductService.php:151
msgid "You cannot create variable products."
msgstr "Vous ne pouvez pas créer de produits variables."

#: src/Application/VariableProducts/VariableProductService.php:168
msgid "You cannot use one or more selected variation images."
msgstr "Vous ne pouvez pas utiliser une ou plusieurs images de variation sélectionnées."

#: src/Application/VariableProducts/VariationInputParser.php:52
msgid "Expected a price or null."
msgstr "Un prix ou une valeur nulle est attendu."

#: src/Application/VariableProducts/VariationInputParser.php:55
msgid "Variation SKU must be 100 characters or fewer."
msgstr "Le SKU de la variation doit comporter 100 caractères maximum."

#: src/Application/VariableProducts/VariationInputParser.php:102
msgid "Choose a supported stock status."
msgstr "Choisissez un état de stock pris en charge."

#: src/Application/VariableProducts/VariationInputParser.php:123
msgid "The combination contains unsupported fields."
msgstr "La combinaison contient des champs non pris en charge."

#: src/Application/VariableProducts/VariationInputParser.php:146
msgid "Expected a non-negative numeric ID."
msgstr "Un identifiant numérique positif ou nul est attendu."

#: src/Infrastructure/WooCommerce/WooProductGateway.php:43
