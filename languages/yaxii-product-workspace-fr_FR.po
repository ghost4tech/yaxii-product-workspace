msgstr "Attendez la fin de cette opération avant de la supprimer de la file d’attente."

#: src/Rest/PreferenceController.php:68
msgid "Send a JSON preference object."
msgstr "Envoyez un objet de préférence JSON."

#: src/Rest/ProductController.php:103
#: src/Rest/VariableProductController.php:78
