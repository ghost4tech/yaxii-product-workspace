msgstr "Envoyez un objet de produit variable JSON."

#: yaxii-product-workspace.php:42
msgid "Yaxii Product Workspace cannot start because its Composer dependencies are missing."
msgstr "Yaxii Product Workspace ne peut pas démarrer car ses dépendances Composer sont manquantes."

#: languages/source/yaxii-product-workspace.js:3
msgid "— attributes such as color or size produce separate variations, each with its own price, SKU, stock, and image."
msgstr "— les attributs tels que la couleur ou la taille produisent des variations distinctes, chacune avec son propre prix, SKU, stock et image."

#: languages/source/yaxii-product-workspace.js:4
msgid "— one price and stock value."
msgstr "— un prix et une valeur de stock."

#. translators: %s: taxonomy field label.
#: languages/source/yaxii-product-workspace.js:6
msgctxt "List separator"
msgid ", "
msgstr ","

#. translators: %s: product name.
#: languages/source/yaxii-product-workspace.js:8
#, js-format
msgid "“%s” will leave recent operations. Its WooCommerce product will not be trashed."
msgstr "« %s » sera retiré des opérations récentes. Le produit WooCommerce associé ne sera pas mis à la corbeille."

#: languages/source/yaxii-product-workspace.js:9
msgid "“3 hours ago” instead of a fixed date."
msgstr "« Il y a 3 heures » au lieu d’une date fixe."

#. translators: 1: enabled variation count, 2: total variation count.
#: languages/source/yaxii-product-workspace.js:13
#, js-format
msgid "%1$s of %2$s enabled"
msgstr "%1$s sur %2$s activées"

#. translators: 1: successful write count, 2: total final write count.
#: languages/source/yaxii-product-workspace.js:15
#, js-format
msgid "%1$s of %2$s final writes"
msgstr "%1$s sur %2$s écritures finales"

#. translators: 1: current image count, 2: maximum image count.
#: languages/source/yaxii-product-workspace.js:17
#, js-format
msgid "%1$s/%2$s · drag to reorder"
msgstr "%1$s/%2$s · faire glisser pour réorganiser"

#. translators: 1: current attribute count, 2: maximum attribute count.
#: languages/source/yaxii-product-workspace.js:19
#, js-format
msgid "%1$s/%2$s attribute"
msgid_plural "%1$s/%2$s attributes"
msgstr[0] "%1$s/%2$s attribut"
msgstr[1] "%1$s/%2$s attributs"

#. translators: %s: color name.
#: languages/source/yaxii-product-workspace.js:21
#, js-format
msgid "%s accent"
msgstr "accent %s"

#. translators: %s: number of selected categories.
#: languages/source/yaxii-product-workspace.js:23
#, js-format
