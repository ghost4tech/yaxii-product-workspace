msgstr "Ce SKU est déjà utilisé par un autre produit."

#. translators: %d: invalid term ID.
#: src/Infrastructure/WooCommerce/WooProductGateway.php:162
#, php-format
msgid "Term ID %d is not valid for this product field."
msgstr "L’ID du terme %d n’est pas valide pour ce champ de produit."

#. translators: %d: invalid image attachment ID.
#: src/Infrastructure/WooCommerce/WooProductGateway.php:180
#, php-format
msgid "Media ID %d is not a valid image attachment."
msgstr "L’identifiant de média %d ne correspond pas à une image valide."

#: src/Infrastructure/WooCommerce/WooProductGateway.php:192
msgid "Choose a configured WooCommerce tax class."
msgstr "Choisissez une classe de taxe WooCommerce configurée."

#. translators: %s: source product name.
#: src/Infrastructure/WooCommerce/WooProductMapper.php:82
#, php-format
msgid "%s (Copy)"
msgstr "%s (Copie)"

#: src/Infrastructure/WooCommerce/WooVariableProductGateway.php:41
msgid "The requested product is not a variable product."
msgstr "Le produit demandé n’est pas un produit variable."

#: src/Infrastructure/WooCommerce/WooVariableProductGateway.php:190
msgid "WooCommerce could not save this variation."
msgstr "WooCommerce n’a pas pu enregistrer cette variation."

#: src/Infrastructure/WooCommerce/WooVariableReferenceValidator.php:39
msgid "Choose an existing WooCommerce global attribute."
msgstr "Choisissez un attribut global WooCommerce existant."

#: src/Infrastructure/WooCommerce/WooVariableReferenceValidator.php:44
