msgid "https://yaxii.dev/"
msgstr "https://yaxii.dev/"

#. Description of the plugin
#: yaxii-product-workspace.php
msgid "A focused WooCommerce product-entry workspace for WordPress administrators."
msgstr "مساحة عمل WooCommerce مخصصة لإدخال المنتجات لمسؤولي WordPress."

#. Author of the plugin
#: yaxii-product-workspace.php
msgid "Yaxii Dev"
msgstr "Yaxii Dev"

#: src/Admin/AdminPage.php:47
msgid "Product Workspace"
msgstr "مساحة عمل المنتجات"

#: src/Admin/AdminPage.php:147
msgid "You are not allowed to access this workspace."
msgstr "لا تملك صلاحية الوصول إلى مساحة العمل هذه."

#: src/Admin/AdminPage.php:183
msgid "The Product Workspace frontend is unavailable because its built assets are missing."
msgstr "واجهة مساحة عمل المنتجات غير متاحة، لأن ملفاتها المبنية مفقودة."

#: src/Admin/AdminPage.php:187
msgid "WooCommerce must be installed and active before the Product Workspace can be used."
msgstr "يجب تثبيت WooCommerce وتنشيطه قبل استخدام مساحة عمل المنتج."

#: src/Admin/AdminPage.php:190
msgid "Loading Yaxii Product Workspace..."
msgstr "جارٍ تحميل Yaxii Product Workspace…"

#: src/Application/Preferences/PreferenceService.php:60
msgid "The preference request contains unsupported fields."
msgstr "يحتوي طلب التفضيل على حقول غير مدعومة."

#: src/Application/Preferences/PreferenceService.php:65
msgid "Review the workspace preferences."
msgstr "راجع تفضيلات مساحة العمل."

#: src/Application/Preferences/PreferenceService.php:102
#: src/Application/Products/CreateProductRequestFactory.php:181
#: src/Application/VariableProducts/VariationInputParser.php:130
msgid "Expected true or false."
msgstr "يلزم إدخال قيمة صحيحة أو خاطئة."

#: src/Application/Preferences/PreferenceService.php:113
msgid "Choose only supported repeat fields."
msgstr "اختر حقول التكرار المدعومة فقط."

#: src/Application/Preferences/PreferenceService.php:116
msgid "Choose 10, 25, or 50 queue rows."
msgstr "اختر 10 أو 25 أو 50 صفًا من صفوف الانتظار."

#: src/Application/Preferences/PreferenceService.php:124
#: src/Application/Products/ProductFieldParser.php:28
msgid "Choose a supported value."
msgstr "اختر قيمة مدعومة."

#: src/Application/Products/CreateProductRequestFactory.php:77
msgid "Every product field must be present; send an empty value to clear a field."
msgstr "يجب إرسال جميع حقول المنتج؛ أرسل قيمة فارغة لمسح أي حقل."

