msgid "Product name is required."
msgstr "اسم المنتج مطلوب."

#: src/Application/Products/CreateProductRequestFactory.php:131
msgid "Product name must be 200 characters or fewer."
msgstr "يجب ألا يتجاوز اسم المنتج 200 حرف."

#: src/Application/Products/CreateProductRequestFactory.php:134
msgid "SKU must be 100 characters or fewer."
msgstr "يجب ألا يتجاوز رمز SKU ‏100 حرف."

#: src/Application/Products/CreateProductRequestFactory.php:151
#: src/Application/VariableProducts/VariationInputParser.php:60
msgid "Sale price cannot exceed the regular price."
msgstr "لا يمكن أن يتجاوز سعر التخفيض السعر الاعتيادي."

#: src/Application/Products/CreateProductRequestFactory.php:156
msgid "Sale end date cannot be before the start date."
msgstr "لا يمكن أن يكون تاريخ انتهاء البيع قبل تاريخ البدء."

#: src/Application/Products/CreateProductRequestFactory.php:165
msgid "The request contains unsupported fields."
msgstr "يحتوي الطلب على حقول غير مدعومة."

#: src/Application/Products/CreateProductRequestFactory.php:176
#: src/Application/VariableProducts/VariationInputParser.php:138
msgid "Expected a text value."
msgstr "يلزم إدخال قيمة نصية."

#: src/Application/Products/CreateProductRequestFactory.php:193
msgid "Review the highlighted product fields."
msgstr "راجع حقول المنتج المميزة."

#: src/Application/Products/CreateProductService.php:58
msgid "The product request could not be normalized."
msgstr "تعذرت معالجة طلب المنتج."

#: src/Application/Products/CreateProductService.php:81
msgid "This idempotency key was already used with a different product payload."
msgstr "استُخدم مفتاح منع التكرار هذا من قبل مع بيانات منتج مختلفة."

#: src/Application/Products/CreateProductService.php:111
msgid "This operation is not marked safe for manual retry."
msgstr "لم تُحدد هذه العملية على أنها آمنة لإعادة المحاولة يدويًا."

#: src/Application/Products/CreateProductService.php:126
msgid "This operation is already being reconciled or retried."
msgstr "يجري حاليًا التحقق من هذه العملية أو إعادة محاولتها."

#: src/Application/Products/CreateProductService.php:135
msgid "WooCommerce is not available for product creation."
msgstr "WooCommerce غير متاح لإنشاء المنتج."

#: src/Application/Products/CreateProductService.php:143
msgid "You are not allowed to create products."
msgstr "لا تملك صلاحية إنشاء المنتجات."

#: src/Application/Products/CreateProductService.php:151
#: src/Application/VariableProducts/VariableProductService.php:154
msgid "You can create drafts but cannot publish products."
msgstr "يمكنك إنشاء مسودات ولكن لا يمكنك نشر المنتجات."

#: src/Application/Products/CreateProductService.php:153
msgid "Choose Draft or ask an administrator for publishing access."
msgstr "اختر «مسودة» أو اطلب من أحد المسؤولين صلاحية النشر."

#: src/Application/Products/CreateProductService.php:160
msgid "You are not allowed to assign product terms."
msgstr "لا تملك صلاحية تعيين عناصر المنتج."

#: src/Application/Products/CreateProductService.php:171
msgid "You are not allowed to use one or more selected images."
msgstr "لا يُسمح لك باستخدام صورة واحدة أو أكثر من الصور المحددة."

#: src/Application/Products/CreateProductService.php:209
msgid "WooCommerce could not save the product."
msgstr "تعذر على WooCommerce حفظ المنتج."

#: src/Application/Products/CreateProductService.php:226
msgid "WooCommerce rejected one or more product references."
msgstr "رفض WooCommerce مرجعًا واحدًا أو أكثر من مراجع المنتج."

#: src/Application/Products/OperationResult.php:54
msgid "Some variations were not saved. Retry reconciliation before publishing."
msgstr "لم تُحفظ بعض التنويعات. أعد محاولة التحقق قبل النشر."

#: src/Application/Products/ProductFieldParser.php:39
msgid "A non-negative decimal value is required."
msgstr "يلزم إدخال قيمة عشرية غير سالبة."

#: src/Application/Products/ProductFieldParser.php:44
#: src/Application/VariableProducts/VariationInputParser.php:80
msgid "Enter a valid non-negative decimal value."
msgstr "أدخل قيمة عشرية صالحة غير سالبة."

#: src/Application/Products/ProductFieldParser.php:58
msgid "Enter a valid calendar date."
msgstr "أدخل تاريخًا صالحًا."

