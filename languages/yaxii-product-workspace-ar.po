#: src/Application/VariableProducts/VariableProductManagementService.php:62
#: src/Application/VariableProducts/VariableProductService.php:148
msgid "WooCommerce variable products are unavailable."
msgstr "المنتجات المتغيرة WooCommerce غير متوفرة."

#: src/Application/VariableProducts/VariableProductManagementService.php:71
#: src/Application/VariableProducts/VariableProductService.php:157
msgid "You cannot assign product attributes or terms."
msgstr "لا يمكنك تعيين سمات المنتج أو المصطلحات."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:27
msgid "The variation plan contains unsupported fields."
msgstr "تحتوي خطة التنويعات على حقول غير مدعومة."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:30
msgid "Send attribute and combination lists."
msgstr "أرسل قائمتي السمات والتركيبات."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:36
msgid "At least one attribute must be used for variations."
msgstr "يجب استخدام سمة واحدة على الأقل للتنويعات."

#. translators: %d: maximum attributes.
#: src/Application/VariableProducts/VariableProductPlanFactory.php:63
#, php-format
msgid "Add between one and %d attributes."
msgstr "أضف من سمة واحدة إلى %d سمات."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:72
msgid "Each attribute must be an object."
msgstr "يجب أن تكون كل سمة كائنًا."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:101
msgid "Each attribute requires a unique position."
msgstr "تتطلب كل سمة موقعًا فريدًا."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:117
msgid "The attribute contains unsupported fields."
msgstr "تحتوي السمة على حقول غير مدعومة."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:126
msgid "Use a stable lowercase attribute key."
msgstr "استخدم مفتاح سمة ثابتًا بأحرف لاتينية صغيرة."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:150
msgid "Attribute visibility, variation use, or position is invalid."
msgstr "ظهور السمة أو استخدامها في التنويعات أو موضعها غير صالح."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:175
msgid "Global attributes use term IDs, not custom option text."
msgstr "تستخدم السمات العامة معرّفات العناصر، وليس نصوص الخيارات المخصصة."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:181
msgid "Global attributes require a real WooCommerce attribute ID and pa_* taxonomy."
msgstr "تتطلب السمات العامة معرّف سمة WooCommerce حقيقيًا وتصنيف pa_*."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:196
msgid "Custom attributes cannot reference a global taxonomy or term IDs."
msgstr "لا يمكن للسمات المخصصة الإشارة إلى تصنيف عام أو معرّفات عناصر."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:200
msgid "Select between one and 20 custom options."
msgstr "اختر من بين خيار واحد إلى 20 خيارًا مخصصًا."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:208
msgid "Custom options must be unique non-empty values up to 100 characters."
msgstr "يجب أن تكون الخيارات المخصصة فريدة وغير فارغة، وألا يتجاوز كل منها 100 حرف."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:223
msgid "Select between one and 20 attribute terms."
msgstr "حدد من عنصر واحد إلى 20 عنصرًا للسمة."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:227
msgid "Attribute term IDs must be unique positive integers."
msgstr "يجب أن تكون معرّفات عناصر السمة أعدادًا صحيحة موجبة وفريدة."

#: src/Application/VariableProducts/VariableProductPlanFactory.php:234
msgid "Review the variable-product attributes."
msgstr "راجع سمات المنتج المتغير."

#: src/Application/VariableProducts/VariableProductRequestFactory.php:31
msgid "Send one product, attribute list, and combination list."
msgstr "أرسل منتجًا واحدًا وقائمة سمات وقائمة تركيبات."

#: src/Application/VariableProducts/VariableProductService.php:43
msgid "The variable product could not be normalized."
msgstr "تعذرت معالجة المنتج المتغير."

#: src/Application/VariableProducts/VariableProductService.php:60
msgid "This idempotency key was used with a different variable product."
msgstr "استُخدم مفتاح منع التكرار هذا مع منتج متغير مختلف."

#: src/Application/VariableProducts/VariableProductService.php:79
msgid "This variable operation is not safe to retry."
msgstr "هذه العملية المتغيرة ليست آمنة لإعادة المحاولة."

#: src/Application/VariableProducts/VariableProductService.php:89
msgid "This variable operation is already being reconciled."
msgstr "يجري حاليًا التحقق من هذه العملية المتغيرة."

#: src/Application/VariableProducts/VariableProductService.php:122
msgid "WooCommerce could not save the variable product."
msgstr "تعذر على WooCommerce حفظ المنتج المتغير."

#: src/Application/VariableProducts/VariableProductService.php:131
msgid "WooCommerce rejected variable-product references."
msgstr "رفض WooCommerce مراجع المنتج المتغير."

#: src/Application/VariableProducts/VariableProductService.php:151
msgid "You cannot create variable products."
msgstr "لا يمكنك إنشاء منتجات متغيرة."

#: src/Application/VariableProducts/VariableProductService.php:168
msgid "You cannot use one or more selected variation images."
msgstr "لا يمكنك استخدام صورة تنويع محددة واحدة أو أكثر."

#: src/Application/VariableProducts/VariationInputParser.php:52
msgid "Expected a price or null."
msgstr "يلزم إدخال سعر أو قيمة فارغة."

#: src/Application/VariableProducts/VariationInputParser.php:55
msgid "Variation SKU must be 100 characters or fewer."
msgstr "يجب ألا يتجاوز رمز SKU للتنويع 100 حرف."

#: src/Application/VariableProducts/VariationInputParser.php:102
msgid "Choose a supported stock status."
msgstr "اختر حالة المخزون المدعومة."

#: src/Application/VariableProducts/VariationInputParser.php:123
msgid "The combination contains unsupported fields."
msgstr "تحتوي التركيبة على حقول غير مدعومة."

#: src/Application/VariableProducts/VariationInputParser.php:146
msgid "Expected a non-negative numeric ID."
msgstr "يلزم إدخال معرّف رقمي غير سالب."

#: src/Infrastructure/WooCommerce/WooProductGateway.php:38
msgid "This SKU is already used by another product."
msgstr "هذا SKU مستخدم بالفعل بواسطة منتج آخر."

#. translators: %d: invalid term ID.
#: src/Infrastructure/WooCommerce/WooProductGateway.php:155
#, php-format
msgid "Term ID %d is not valid for this product field."
msgstr "معرّف العنصر %d غير صالح لحقل المنتج هذا."

#. translators: %d: invalid image attachment ID.
#: src/Infrastructure/WooCommerce/WooProductGateway.php:173
#, php-format
msgid "Media ID %d is not a valid image attachment."
msgstr "معرّف الوسائط %d لا يخص مرفق صورة صالحًا."

#: src/Infrastructure/WooCommerce/WooProductGateway.php:185
msgid "Choose a configured WooCommerce tax class."
msgstr "اختر فئة ضريبة WooCommerce التي تم تكوينها."

#. translators: %s: source product name.
#: src/Infrastructure/WooCommerce/WooProductMapper.php:80
#, php-format
msgid "%s (Copy)"
msgstr "%s (نسخة)"

#: src/Infrastructure/WooCommerce/WooVariableProductGateway.php:41
msgid "The requested product is not a variable product."
msgstr "المنتج المطلوب ليس منتجًا متغيرًا."

#: src/Infrastructure/WooCommerce/WooVariableProductGateway.php:190
msgid "WooCommerce could not save this variation."
msgstr "تعذر على WooCommerce حفظ هذا التنويع."

#: src/Infrastructure/WooCommerce/WooVariableReferenceValidator.php:39
msgid "Choose an existing WooCommerce global attribute."
msgstr "اختر سمة WooCommerce عامة وموجودة."

#: src/Infrastructure/WooCommerce/WooVariableReferenceValidator.php:44
msgid "One or more selected terms do not belong to this attribute."
msgstr "عنصر واحد أو أكثر من العناصر المحددة لا ينتمي إلى هذه السمة."

#: src/Infrastructure/WooCommerce/WooVariableReferenceValidator.php:62
msgid "Each variation SKU must be unique across WooCommerce."
msgstr "يجب أن يكون رمز SKU لكل تنويع فريدًا في WooCommerce."

#: src/Infrastructure/WooCommerce/WooVariableReferenceValidator.php:67
msgid "Choose a valid image attachment."
msgstr "اختر مرفق صورة صالحًا."

#: src/Infrastructure/WooCommerce/WooVariableReferenceValidator.php:70
msgid "The variation does not belong to this parent product."
msgstr "لا ينتمي التنويع إلى هذا المنتج الأب."

#: src/Rest/ApiError.php:21
msgid "You must be signed in to use Product Workspace."
msgstr "يجب تسجيل الدخول لاستخدام مساحة عمل المنتجات."

#: src/Rest/ApiError.php:37
msgid "The product operation could not be completed."
msgstr "لا يمكن إكمال عملية المنتج."

#: src/Rest/OperationController.php:152
msgid "Variable-product reconciliation is unavailable."
msgstr "التحقق من المنتج المتغير غير متاح."

#: src/Rest/OperationController.php:163
msgid "Variable-product retry is unavailable."
msgstr "إعادة محاولة المنتج المتغير غير متاحة."

